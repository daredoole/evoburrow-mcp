{
  "name": "evoburrow-mcp",
  "version": "2.0.0-beta.1",
  "type": "module",
  "description": "Unofficial cross-platform MCP control room for A1 Evo AcoustiX, REW, and Denon/Marantz AVRs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "a1-evo",
    "acoustix",
    "denon",
    "marantz",
    "audyssey",
    "rew",
    "room-eq-wizard",
    "audio-calibration",
    "home-theater",
    "home-cinema",
    "room-correction",
    "speaker-calibration",
    "subwoofer-integration",
    "av-receiver",
    "denon-avr",
    "marantz-avr"
  ],
  "author": "daredoole",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/daredoole"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daredoole/evoburrow-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/daredoole/evoburrow-mcp/issues"
  },
  "homepage": "https://github.com/daredoole/evoburrow-mcp#readme",
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "dist/",
    "mcpb/",
    "server.json",
    "knowledge/",
    "lib/",
    "skills/",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "dev": "node server.mjs",
    "test": "npm run build && node --test",
    "coverage": "npm run build && c8 --check-coverage --lines 55 --statements 55 --functions 64 --branches 67 --reporter=text-summary --include=server.mjs --include=advanced.mjs --include=a1-terminal-adapter.mjs --include=lib/*.mjs --exclude=dist/** node --test",
    "validate:release": "node scripts/validate-release.mjs",
    "security:verify": "npm audit --audit-level=moderate && npm audit signatures",
    "mcpb:build": "npm run build && node scripts/build-mcpb.mjs",
    "pack:check": "npm run build && npm run validate:release && npm pack --dry-run --ignore-scripts",
    "prepack": "npm run build && npm run validate:release"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "node-pty": "1.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "esbuild": "0.25.12"
  }
}
